{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "outDir": "./dist",
    "paths": {
      "shared": ["../shared/src"]
    },
    "resolveJsonModule": true,
    "rootDir": "..",
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  "exclude": ["**/*.spec.ts"],
  "include": ["src/"]
}
